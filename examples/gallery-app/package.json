{
  "name": "@nanoflare/gallery-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "$npm_execpath run nf-typegen && vite build && vite build --config vite.worker.config.ts",
    "nf-typegen": "nanoflare types",
    "deploy": "$npm_execpath run build && nanoflare deploy",
    "check": "nanoflare types --check && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.2.3",
    "@valibot/to-json-schema": "^1.7.1",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.12.33",
    "hono-openapi": "^1.3.1",
    "mime": "^4.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@nanoflare/cli": "^0.1.2",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.2",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
