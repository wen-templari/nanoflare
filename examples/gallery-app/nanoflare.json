{
  "$schema": "https://raw.githubusercontent.com/wen-templari/nanoflare/main/schemas/nanoflare.json",
  "name": "gallery-app",
  "main": "dist/worker.js",
  "format": "modules",
  "compatibility_date": "2025-12-10",
  "vite": {
    "entry": "worker/index.ts"
  },
  "files": ["dist/worker.js"],
  "db": [
    {
      "binding": "GALLERY_DB",
      "database_id": "d2926c6ca2e61cc49b6f110664f3ca72275a6798518f2c4c"
    }
  ],
  "object_storage_buckets": [
    {
      "binding": "OBJECTS",
      "bucket_id": "d125d3ce69fe1ccc2196a8b27cc7871b2275833998c509ab"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "auth": {}
}
