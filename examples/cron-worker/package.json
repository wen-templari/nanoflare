{
  "name": "@nanoflare/cron-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "$npm_execpath run nf-typegen && tsc -p tsconfig.json",
    "nf-typegen": "nanoflare types",
    "deploy": "$npm_execpath run build && nanoflare deploy",
    "check": "nanoflare types --check && tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@nanoflare/cli": "^0.1.0",
    "typescript": "^5.8.3"
  }
}
