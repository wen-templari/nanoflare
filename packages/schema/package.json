{
  "name": "@nanoflare/schema",
  "version": "1.0.0",
  "description": "Generated TypeScript contract for the Nanoflare OpenAPI endpoint.",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/openapi.ts"
    }
  },
  "scripts": {
    "generate": "go run ../../cmd/nanoflare-openapi ./openapi.json && openapi-typescript ./openapi.json -o ./src/openapi.ts",
    "check": "tsc --noEmit",
    "test": "pnpm run check"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.11.0"
}
