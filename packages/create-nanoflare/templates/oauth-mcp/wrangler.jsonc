{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "{{projectName}}",
  "main": "src/worker.ts",
  "compatibility_date": "{{compatibilityDate}}",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "00000000000000000000000000000001",
    },
  ],
  "nanoflare": {
    "auth": {},
  },
}
