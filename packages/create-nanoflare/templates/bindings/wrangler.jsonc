{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "{{projectName}}",
  "main": "src/worker.ts",
  "compatibility_date": "{{compatibilityDate}}",
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "00000000000000000000000000000001",
    },
  ],
  "r2_buckets": [
    {
      "binding": "OBJECTS",
      "bucket_name": "{{projectName}}-objects",
    },
  ],
}
