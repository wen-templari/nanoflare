{
  "$schema": "https://raw.githubusercontent.com/wen-templari/nanoflare/main/schemas/nanoflare.json",
  "name": "{{projectName}}",
  "main": "src/worker.ts",
  "compatibility_date": "{{compatibilityDate}}",
  "kv_namespaces": [
    {
      "binding": "KV"
    }
  ],
  "r2_buckets": [
    {
      "binding": "OBJECTS",
      "bucket_name": "{{projectName}}-objects"
    }
  ]
}
