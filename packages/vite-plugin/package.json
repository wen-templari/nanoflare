{
  "name": "@nanoflare/vite-plugin",
  "version": "0.0.1",
  "description": "Run a Nanoflare Worker locally during Vite development.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.build.json --noEmit",
    "test": "pnpm run build && node --test test/**/*.test.mjs"
  },
  "dependencies": {
    "miniflare": "^4.20260206.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
