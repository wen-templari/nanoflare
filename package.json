{
  "name": "nanoflare",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "schema:generate": "pnpm --filter @nanoflare/schema generate",
    "examples:update-cli": "node scripts/update-example-cli.mjs",
    "test:examples:update-cli": "node --test scripts/update-example-cli.test.mjs",
    "lint": "vp lint packages",
    "format": "vp format packages templates",
    "typecheck": "vp lint --type-check packages",
    "dev:ui": "vp run @nanoflare/ui#dev"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.17.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
