{
  "uid": "nanoflare-stack-overview",
  "title": "Nanoflare Stack Overview",
  "tags": ["nanoflare"],
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Service health",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "title": "Prometheus scrape health",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Reachability of the metrics endpoints.",
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"nanoflared|traefik\"}",
          "legendFormat": "{{job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                }
              }
            }
          ],
          "noValue": "Unavailable"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Firing Nanoflare alerts",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "count(ALERTS{alertname=~\"Nanoflare.*\",alertstate=\"firing\"}) or vector(0)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Runner resource sample age",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Age of the last authenticated runner sample. Fresh resource measurements must be available and no more than 20 seconds old.",
      "targets": [
        {
          "refId": "A",
          "expr": "max(nanoflare_runner_resource_sample_age_seconds and (nanoflare_runner_resources_available == 1))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unavailable",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "Dropped log events (5m)",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Drops reported by the daemon forwarder. Use the logs panel to inspect events delivered to Loki.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(nanoflare_log_forwarder_dropped_total[5m]))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.001
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 6,
      "title": "Worker traffic",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 7,
      "title": "Requests per second",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Traffic across all Traefik instrumented routes. With no requests yet, traffic and latency panels have no data.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(traefik_router_requests_total{job=\"traefik\"}[$__rate_interval]))",
          "legendFormat": "Requests",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "HTTP 5xx rate",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 6,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(traefik_router_requests_total{job=\"traefik\",code=~\"5..\"}[$__rate_interval])) or 0 * sum(rate(traefik_router_requests_total{job=\"traefik\"}[$__rate_interval]))) / (sum(rate(traefik_router_requests_total{job=\"traefik\"}[$__rate_interval])) > 0)",
          "legendFormat": "5xx",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "HTTP request latency",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Latency observed at Traefik across instrumented routes.",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(traefik_router_request_duration_seconds_bucket{job=\"traefik\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traefik_router_request_duration_seconds_bucket{job=\"traefik\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(traefik_router_request_duration_seconds_bucket{job=\"traefik\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "title": "Top routes by current request rate",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Request rate and latency use the recent rate window. 5xx count and percentage use the selected dashboard time range.",
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (router) (rate(traefik_router_requests_total{job=\"traefik\"}[$__rate_interval])) > 0)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "(sum by (router) (increase(traefik_router_requests_total{job=\"traefik\",code=~\"5..\"}[$__range])) or 0 * sum by (router) (increase(traefik_router_requests_total{job=\"traefik\"}[$__range]))) and on (router) topk(10, sum by (router) (rate(traefik_router_requests_total{job=\"traefik\"}[$__rate_interval])) > 0)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "((sum by (router) (increase(traefik_router_requests_total{job=\"traefik\",code=~\"5..\"}[$__range])) or 0 * sum by (router) (increase(traefik_router_requests_total{job=\"traefik\"}[$__range]))) / (sum by (router) (increase(traefik_router_requests_total{job=\"traefik\"}[$__range])) > 0)) and on (router) topk(10, sum by (router) (rate(traefik_router_requests_total{job=\"traefik\"}[$__rate_interval])) > 0)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.95, sum by (router, le) (rate(traefik_router_request_duration_seconds_bucket{job=\"traefik\"}[$__rate_interval]))) and on (router) topk(10, sum by (router) (rate(traefik_router_requests_total{job=\"traefik\"}[$__rate_interval])) > 0)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Requests/sec"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "5xx rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95 latency"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Route"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 490
              }
            ]
          }
        ]
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Requests/sec",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time #A": true,
              "Time #B": true,
              "Time #C": true,
              "Time #D": true
            },
            "renameByName": {
              "router": "Route",
              "Value #A": "Requests/sec",
              "Value #B": "5xx count",
              "Value #C": "5xx rate",
              "Value #D": "p95 latency"
            }
          }
        }
      ]
    },
    {
      "id": 11,
      "title": "Runtime capacity",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 12,
      "title": "Runner memory",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "The limit is shown when a finite bound is reported.",
      "targets": [
        {
          "refId": "A",
          "expr": "nanoflare_runner_memory_current_bytes",
          "legendFormat": "Used {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "nanoflare_runner_memory_limit_bytes > 0",
          "legendFormat": "Limit {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "title": "Runner PIDs",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 21,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "The limit is shown when a finite bound is reported.",
      "targets": [
        {
          "refId": "A",
          "expr": "nanoflare_runner_pids_current",
          "legendFormat": "Used {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "nanoflare_runner_pids_limit > 0",
          "legendFormat": "Limit {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 14,
      "title": "Runtime errors and OOM kills (5m)",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 21,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(nanoflare_worker_gateway_errors_total[5m]))",
          "legendFormat": "Gateway errors",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum(increase(nanoflare_runner_oom_kills_total[5m]))",
          "legendFormat": "OOM kills",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 15,
      "title": "Recent errors",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 16,
      "title": "Platform and Worker errors",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Filtered by the Log services regex. Expand a log line to see service, Worker and deployment labels when available.",
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"${log_services:raw}\"} | json | __error__=\"\" | (level=~\"(?i)error|fatal|panic|critical\" or line=~\"(?i).*(error|fatal|panic).*\" or message=~\"(?i).*(error|fatal|panic).*\") | line_format \"{{if .line}}{{.line}}{{else}}{{.message}}{{end}}\"",
          "legendFormat": "",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "maxLines": 100
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ],
  "description": "Operator overview of traffic, runner capacity and recent errors. Scrape health covers Traefik and nanoflared; other services are not directly probed.",
  "templating": {
    "list": [
      {
        "name": "log_services",
        "label": "Log services (regex)",
        "type": "textbox",
        "query": "docker-(nanoflared|nanoflare-runner|traefik)-.+|host-runtime",
        "current": {
          "text": "docker-(nanoflared|nanoflare-runner|traefik)-.+|host-runtime",
          "value": "docker-(nanoflared|nanoflare-runner|traefik)-.+|host-runtime",
          "selected": false
        },
        "options": [
          {
            "text": "docker-(nanoflared|nanoflare-runner|traefik)-.+|host-runtime",
            "value": "docker-(nanoflared|nanoflare-runner|traefik)-.+|host-runtime",
            "selected": true
          }
        ],
        "hide": 0
      }
    ]
  }
}
