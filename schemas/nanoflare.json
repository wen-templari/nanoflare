{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/wen-templari/nanoflare/main/schemas/nanoflare.json",
  "title": "Nanoflare worker configuration",
  "description": "Configuration for a Nanoflare Worker project (nanoflare.json).",
  "type": "object",
  "required": ["name", "main", "compatibility_date"],
  "properties": {
    "$schema": {
      "description": "The URL of this schema.",
      "type": "string",
      "format": "uri"
    },
    "name": { "type": "string", "minLength": 1 },
    "main": {
      "description": "Path to the entrypoint, relative to the project directory.",
      "type": "string",
      "minLength": 1
    },
    "format": { "enum": ["modules", "service-worker"] },
    "compatibility_date": { "type": "string", "format": "date" },
    "compatibility_flags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "triggers": {
      "type": "object",
      "properties": {
        "crons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": true
    },
    "vars": {
      "description": "JSON values exposed as Worker bindings.",
      "type": "object",
      "additionalProperties": true
    },
    "files": {
      "description": "Worker files to upload, relative to the project directory.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "kv_namespaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/kvBinding" }
    },
    "db": {
      "type": "array",
      "items": { "$ref": "#/$defs/databaseBinding" }
    },
    "object_storage_buckets": {
      "type": "array",
      "items": { "$ref": "#/$defs/objectStorageBucketBinding" }
    },
    "services": {
      "description": "Private bindings to Workers in the same organization.",
      "type": "array",
      "items": { "$ref": "#/$defs/serviceBinding" }
    },
    "assets": { "$ref": "#/$defs/assets" },
    "auth": { "$ref": "#/$defs/auth" },
    "secrets": { "$ref": "#/$defs/secrets" }
  },
  "additionalProperties": true,
  "$defs": {
    "bindingName": { "type": "string", "minLength": 1 },
    "kvBinding": {
      "type": "object",
      "required": ["binding", "id"],
      "properties": {
        "binding": { "$ref": "#/$defs/bindingName" },
        "id": { "type": "string", "minLength": 1 },
        "preview_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "databaseBinding": {
      "type": "object",
      "required": ["binding", "database_id"],
      "properties": {
        "binding": { "$ref": "#/$defs/bindingName" },
        "database_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "objectStorageBucketBinding": {
      "type": "object",
      "required": ["binding", "bucket_id"],
      "properties": {
        "binding": { "$ref": "#/$defs/bindingName" },
        "bucket_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "serviceBinding": {
      "type": "object",
      "required": ["binding", "service"],
      "properties": {
        "binding": { "$ref": "#/$defs/bindingName" },
        "service": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "object",
      "properties": {
        "binding": { "$ref": "#/$defs/bindingName" },
        "directory": { "type": "string", "minLength": 1 },
        "html_handling": { "enum": ["none", "auto-trailing-slash"] },
        "not_found_handling": { "enum": ["none", "404-page", "single-page-application"] },
        "run_worker_first": {
          "oneOf": [
            { "type": "boolean" },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^!?/(?:[^*]+|(?:[^*]*/)?\\*)$"
              }
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "auth": {
      "type": "object",
      "properties": {
        "protected_routes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/(?:[^*]*|(?:[^*]*/)?\\*)$"
          }
        }
      },
      "additionalProperties": true
    },
    "secrets": {
      "type": "object",
      "properties": {
        "required": {
          "type": "array",
          "items": { "$ref": "#/$defs/bindingName" }
        }
      },
      "additionalProperties": true
    }
  }
}
