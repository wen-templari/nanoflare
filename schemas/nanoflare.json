{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/wen-templari/nanoflare/main/schemas/nanoflare.json",
  "title": "Nanoflare worker configuration",
  "description": "Cloudflare-compatible Worker source configuration for Nanoflare. JSON, JSONC, and TOML use the same fields.",
  "type": "object",
  "required": ["name", "main", "compatibility_date"],
  "properties": {
    "$schema": {
      "description": "The URL of this schema.",
      "type": "string",
      "format": "uri-reference"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "main": {
      "description": "Path to the entrypoint, relative to the project directory.",
      "type": "string",
      "minLength": 1
    },
    "format": {
      "enum": ["modules", "service-worker"],
      "deprecated": true
    },
    "compatibility_date": {
      "type": "string",
      "format": "date"
    },
    "compatibility_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dns": {
      "$ref": "#/$defs/dns",
      "deprecated": true
    },
    "triggers": {
      "type": "object",
      "properties": {
        "crons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "vars": {
      "description": "JSON values exposed as Worker bindings.",
      "type": "object",
      "additionalProperties": true
    },
    "files": {
      "description": "Legacy deployment manifest file list. Source configurations only need main.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "deprecated": true
    },
    "kv_namespaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/kvBinding"
      }
    },
    "db": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/databaseBinding"
      },
      "deprecated": true
    },
    "object_storage_buckets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/objectStorageBucketBinding"
      },
      "deprecated": true
    },
    "services": {
      "description": "Private bindings to Workers in the same organization.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/serviceBinding"
      }
    },
    "assets": {
      "$ref": "#/$defs/assets"
    },
    "auth": {
      "$ref": "#/$defs/auth",
      "deprecated": true
    },
    "secrets": {
      "$ref": "#/$defs/secrets",
      "deprecated": true
    },
    "worker_id": {
      "type": "string",
      "minLength": 1,
      "description": "Existing immutable Worker ID, including a private namespace script. Deploy never creates a public Worker when this is set.",
      "deprecated": true
    },
    "dispatch_namespaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["binding"],
        "properties": {
          "binding": {
            "type": "string",
            "minLength": 1
          },
          "namespace_id": {
            "type": "string",
            "minLength": 1
          },
          "namespace": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "oneOf": [
          {
            "required": ["namespace"]
          },
          {
            "required": ["namespace_id"]
          }
        ]
      }
    },
    "d1_databases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/d1Binding"
      }
    },
    "r2_buckets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/r2Binding"
      }
    },
    "nanoflare": {
      "type": "object",
      "properties": {
        "worker_id": {
          "type": "string",
          "minLength": 1,
          "description": "Existing immutable Worker ID, including a private namespace script. Deploy never creates a public Worker when this is set.",
          "deprecated": true
        },
        "dns": {
          "$ref": "#/$defs/dns",
          "deprecated": true
        },
        "auth": {
          "$ref": "#/$defs/auth",
          "deprecated": true
        },
        "secrets": {
          "$ref": "#/$defs/secrets",
          "deprecated": true
        },
        "resource_ids": {
          "type": "object",
          "description": "Nanoflare resource ID overrides keyed by binding name; Cloudflare IDs stay in their portable fields.",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "account_id": {
      "type": "string"
    },
    "workers_dev": {
      "type": "boolean"
    },
    "preview_urls": {
      "type": "boolean"
    },
    "env": {
      "type": "object",
      "description": "Named environments are retained but selection is not supported yet."
    }
  },
  "additionalProperties": true,
  "$defs": {
    "bindingName": {
      "type": "string",
      "minLength": 1
    },
    "dns": {
      "description": "Selects a platform-managed private DNS profile. Omit profile to inherit the platform default.",
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "kvBinding": {
      "type": "object",
      "required": ["binding"],
      "properties": {
        "binding": {
          "$ref": "#/$defs/bindingName"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "preview_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "databaseBinding": {
      "type": "object",
      "required": ["binding"],
      "properties": {
        "binding": {
          "$ref": "#/$defs/bindingName"
        },
        "database_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "objectStorageBucketBinding": {
      "type": "object",
      "required": ["binding"],
      "properties": {
        "binding": {
          "$ref": "#/$defs/bindingName"
        },
        "bucket_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "serviceBinding": {
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "#/$defs/bindingName"
        },
        "service": {
          "type": "string",
          "minLength": 1
        },
        "worker_id": {
          "type": "string",
          "minLength": 1,
          "description": "Exact immutable target Worker ID."
        }
      },
      "additionalProperties": false,
      "required": ["binding"],
      "anyOf": [
        {
          "required": ["service"]
        },
        {
          "required": ["worker_id"]
        }
      ]
    },
    "assets": {
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "#/$defs/bindingName"
        },
        "directory": {
          "type": "string",
          "minLength": 1
        },
        "html_handling": {
          "enum": ["none", "auto-trailing-slash"]
        },
        "not_found_handling": {
          "enum": ["none", "404-page", "single-page-application"]
        },
        "run_worker_first": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^!?/(?:[^*]+|(?:[^*]*/)?\\*)$"
              }
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "auth": {
      "type": "object",
      "properties": {
        "protected_routes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/(?:[^*]*|(?:[^*]*/)?\\*)$"
          }
        }
      },
      "additionalProperties": true
    },
    "secrets": {
      "type": "object",
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bindingName"
          }
        }
      },
      "additionalProperties": true
    },
    "d1Binding": {
      "type": "object",
      "required": ["binding"],
      "properties": {
        "binding": {
          "$ref": "#/$defs/bindingName"
        },
        "database_name": {
          "type": "string"
        },
        "database_id": {
          "type": "string"
        },
        "preview_database_id": {
          "type": "string"
        },
        "migrations_dir": {
          "type": "string"
        },
        "migrations_table": {
          "type": "string"
        },
        "migrations_pattern": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "r2Binding": {
      "type": "object",
      "required": ["binding"],
      "properties": {
        "binding": {
          "$ref": "#/$defs/bindingName"
        },
        "bucket_name": {
          "type": "string"
        },
        "preview_bucket_name": {
          "type": "string"
        },
        "jurisdiction": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
